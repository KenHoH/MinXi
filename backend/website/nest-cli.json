{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/website-api-gateway/src",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ],
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/website-api-gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/website-api-gateway",
  "projects": {
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "board-app": {
      "type": "application",
      "root": "apps/board-app",
      "entryFile": "main",
      "sourceRoot": "apps/board-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/board-app/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "content-app": {
      "type": "application",
      "root": "apps/content-app",
      "entryFile": "main",
      "sourceRoot": "apps/content-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/content-app/tsconfig.app.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "log-app": {
      "type": "application",
      "root": "apps/log-app",
      "entryFile": "main",
      "sourceRoot": "apps/log-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/log-app/tsconfig.app.json"
      }
    },
    "user": {
      "type": "application",
      "root": "apps/user",
      "entryFile": "main",
      "sourceRoot": "apps/user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user/tsconfig.app.json"
      }
    },
    "website-api-gateway": {
      "type": "application",
      "root": "apps/website-api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/website-api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/website-api-gateway/tsconfig.app.json"
      }
    }
  }
}