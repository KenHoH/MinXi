// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../user/generated/user-client"
}

datasource db {
  provider = "mysql"
  url      = env("USER_DATABASE_URL")
}

model User {
  user_id                         Int     @id @default(autoincrement())
  username                        String
  password                        String
  desc                            String
  profile_picture                 String
  follower                        Int
  total_like                      Int
  total_reports                   Int
  content_visibilityPrivate       Boolean @default(false)
  pinned_visibilityPrivate        Boolean @default(false)
  liked_visibilityPrivate         Boolean @default(false)
  liked_notification_disabled     Boolean @default(false)
  comments_notification_disabled  Boolean @default(false)
  followers_notification_disabled Boolean @default(false)

  area_id Int

  @@unique([username, area_id])
}

model Follow {
  id          Int @id @default(autoincrement())
  creator_id  Int
  follower_id Int

  @@unique([creator_id, follower_id])
  @@index([follower_id])
}

model Friend {
  id        Int @id @default(autoincrement())
  user_id   Int
  friend_id Int

  @@unique([user_id, friend_id])
  @@index([friend_id])
}
