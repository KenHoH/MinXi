generator client {
  provider = "prisma-client-js"
  output   = "../user/generated/user-client"
}

datasource db {
  provider = "mysql"
  url      = env("USER_DATABASE_URL")
}

model User {
  user_id                   Int     @id @default(autoincrement())
  username                  String  @unique
  password                  String
  desc                      String
  profile_picture           String
  follower                  Int
  total_like                Int
  total_reports             Int
  content_visibilityPrivate Boolean @default(false)
  pinned_visibilityPrivate  Boolean @default(false)
  liked_visibilityPrivate   Boolean @default(false)
}
