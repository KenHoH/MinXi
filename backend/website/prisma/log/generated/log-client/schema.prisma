generator client {
  provider = "prisma-client-js"
  output   = "../log/generated/log-client"
}

datasource db {
  provider = "mysql"
  url      = env("LOG_DATABASE_URL")
}

model UserLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  method    String
  path      String
  meta      Json?
  createdAt DateTime @default(now())
}

model Report {
  id        Int      @id @default(autoincrement())
  creatorId Int
  userId    Int
  desc      String
  type      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([creatorId, userId, type])
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  sendId      Int?
  isSeen      Boolean  @default(false)
  title       String
  description String
  createdAt   DateTime @default(now())
}
