// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../content/generated/content-client"
}

datasource db {
  provider = "mysql"
  url      = env("CONTENT_DATABASE_URL")
}

model Content {
  content_id        Int      @default(autoincrement())
  creator_id        Int
  parent_id         Int?
  title             String
  description       String
  post_type         String
  visibilityPrivate Boolean  @default(false)
  views             Int      @default(0)
  likes             Int      @default(0)
  comments          Int      @default(0)
  pins              Int      @default(0)
  reports           Int      @default(0)
  area_id           Int
  created_at        DateTime @default(now())

  @@id([content_id, area_id])
}

model File {
  file_id   Int     @id @default(autoincrement())
  filepath  String
  thumbnail String?

  content_id      Int
  content_area_id Int

  @@unique([content_id, filepath])
  @@index([content_id, content_area_id])
}

model HistoryContent {
  user_id    Int     @default(0)
  content_id Int     @default(0)
  reps       Int     @default(0)
  liked      Boolean @default(false)
  pinned     Boolean @default(false)

  @@id([user_id, content_id])
}

model Board {
  board_id          Int            @id @default(autoincrement())
  board_thumbnail   String
  creator_id        Int
  visibilityPrivate Boolean        @default(false)
  title             String
  description       String
  contents          BoardContent[]
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
}

model BoardContent {
  id         Int      @id @default(autoincrement())
  board_id   Int
  board      Board    @relation(fields: [board_id], references: [board_id], onDelete: Cascade)
  content_id Int
  created_at DateTime @default(now())

  @@unique([board_id, content_id])
  @@index([board_id])
}
